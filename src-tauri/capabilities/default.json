{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认权限配置",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://i.weread.qq.com/*" }]
    }
  ]
}
