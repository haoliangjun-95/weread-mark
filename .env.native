# 移动 App（Capacitor）构建环境变量：WebView 从本地加载，必须直连 API（完整端点路径，POST 根路径 404）
# 注意：网关 CORS 只允许 weread.qq.com 源，Capacitor WebView 直连会被拦，待真机验收时接 CapacitorHttp
VITE_WEREAD_API_URL=https://i.weread.qq.com/api/agent/gateway
VITE_COVER_PROXY=false
VITE_SKILL_VERSION=1.0.4

# ICP 备案信息（留空则不显示）
VITE_ICP_RECORD_NO=
VITE_ICP_RECORD_URL=
